# ScamShield AI Backend Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.

PROJECT_NAME="ScamShield AI"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Allowed Frontend Origins for CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://scamshield-ai-je1u.vercel.app"]

# Privacy & Security Hardening
REDACT_PII_IN_LOGS=true
MAX_TEXT_ANALYSIS_LENGTH=10000
RATE_LIMIT_PER_MINUTE=60

# External Threat Intelligence APIs (Optional)
# If left unset, ScamShield operates fully using local verified heuristic & threat signature engines
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
ENABLE_EXTERNAL_INTEL=true
